{
  "name": "@api3/contracts",
  "description": "Contracts through which API3 services are delivered",
  "keywords": [
    "api3",
    "data feed",
    "oracle",
    "oev"
  ],
  "license": "MIT",
  "version": "41.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/api3dao/contracts.git"
  },
  "private": false,
  "main": "./dist/cjs/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/src/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      }
    },
    "./package.json": "./package.json",
    "./access/*": "./access/*",
    "./api3-server-v1/*": "./api3-server-v1/*",
    "./interfaces/*": "./interfaces/*",
    "./mock/*": "./mock/*",
    "./utils/*": "./utils/*",
    "./vendor/*": "./vendor/*"
  },
  "files": [
    "access",
    "api3-server-v1",
    "interfaces",
    "mock",
    "utils",
    "vendor",
    "dist"
  ],
  "bin": {
    "api3-contracts": "./dist/esm/bin/cli.js"
  },
  "scripts": {
    "build": "pnpm check && pnpm build:hardhat && pnpm generate && pnpm build:esm && pnpm build:cjs && tsx scripts/write-dist-package-json.ts",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:hardhat": "hardhat build",
    "check": "pnpm check:chains && pnpm check:chain-support && pnpm check:deployment-addresses && pnpm check:metadata && pnpm check:example-env-file && pnpm check:dapps",
    "check:chain-support": "tsx scripts/check-chain-support.ts",
    "check:chains": "tsx scripts/check-chains.ts",
    "check:dapps": "tsx scripts/check-dapps.ts",
    "check:deployment-addresses": "tsx scripts/check-deployment-addresses.ts",
    "check:example-env-file": "tsx scripts/check-example-env-file.ts",
    "check:metadata": "tsx scripts/check-metadata.ts",
    "cli": "tsx bin/cli.ts",
    "deploy:hardhat": "hardhat deploy",
    "deploy:deterministic": "pnpm check:chain-support && DETERMINISTIC=true hardhat deploy --network $NETWORK && pnpm generate:deployment-addresses",
    "deploy:undeterministic": "pnpm check:chain-support && hardhat deploy --network $NETWORK && pnpm generate:deployment-addresses",
    "generate": "pnpm generate:chains && pnpm generate:dapps && pnpm generate:metadata && pnpm generate:deployment-addresses",
    "generate:chains": "tsx scripts/generate-chains.ts",
    "generate:dapps": "tsx scripts/generate-dapps.ts",
    "generate:deployment-addresses": "tsx scripts/generate-deployment-addresses.ts",
    "generate:example-env-file": "tsx scripts/generate-example-env-file.ts",
    "generate:metadata": "tsx scripts/generate-metadata.ts",
    "lint": "pnpm run prettier:check && pnpm run lint:eslint && pnpm run lint:solhint",
    "lint:solhint": "solhint ./contracts/**/*.sol",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "prepack": "./prepack.sh",
    "prettier:check": "prettier --check \"./**/*.{js,cjs,ts,md,json,sol}\"",
    "prettier": "prettier --write \"./**/*.{js,cjs,ts,md,json,sol}\"",
    "postpack": "./postpack.sh",
    "survey-roles": "tsx scripts/survey-roles.ts",
    "test": "pnpm test:hardhat && pnpm test:jest",
    "test:hardhat": "hardhat test mocha",
    "test:hardhat:coverage": "NO_PARALLEL=true hardhat test mocha --coverage",
    "test:hardhat:extended": "EXTENDED_TEST=TRUE hardhat test mocha",
    "test:hardhat:gas": "NO_PARALLEL=true hardhat test mocha --gas-stats",
    "test:jest": "jest",
    "validate-verification-api": "tsx scripts/validate-verification-api.ts",
    "validate-deployments": "tsx scripts/validate-deployments.ts",
    "verify-deployments": "tsx scripts/verify-deployments.ts",
    "verify-vendor-contracts": "tsx scripts/verify-vendor-contracts.ts"
  },
  "devDependencies": {
    "@api3/commons": "^1.3.0",
    "@api3/eslint-plugin-commons": "^3.1.1",
    "@changesets/cli": "^2.31.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-keystore": "^3.0.0",
    "@nomicfoundation/hardhat-mocha": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/ignition-core": "^3.0.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@rocketh/deploy": "^0.19.21",
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^5.3.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "glob": "^11.1.0",
    "hardhat": "^3.15.0",
    "hardhat-deploy": "^2.0.26",
    "jest": "^30.5.0",
    "keycard-hardhat-provider": "1.0.0-beta.0",
    "mocha": "^11.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "rocketh": "^0.21.0",
    "solhint": "^5.2.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "viem": "^2.52.2",
    "yargs": "^17.7.3",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.28.0"
}
